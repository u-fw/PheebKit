{
  "name": "pheebkit-ui",
  "private": true,
  "version": "0.2.0-rc.5",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "prebuild": "node ../scripts/normalize-bindings.mjs",
    "build": "npm run typecheck && vite build",
    "build:dev": "vite build --mode development",
    "test": "vitest run && npm run test:locales",
    "test:locales": "node ../scripts/check-locales.mjs",
    "lint": "eslint src",
    "format": "prettier --write src index.html package.json tsconfig.json vite.config.ts eslint.config.js",
    "format:check": "prettier --check src index.html package.json tsconfig.json vite.config.ts eslint.config.js"
  },
  "dependencies": {
    "@material/material-color-utilities": "0.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
