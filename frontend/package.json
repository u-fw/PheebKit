{
  "name": "pheebkit-ui",
  "private": true,
  "version": "0.2.0-beta.7",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:dev": "vite build --mode development",
    "test": "vitest run",
    "lint": "eslint src",
    "format": "prettier --write src index.html package.json tsconfig.json vite.config.ts eslint.config.js",
    "format:check": "prettier --check src index.html package.json tsconfig.json vite.config.ts eslint.config.js"
  },
  "dependencies": {
    "@wailsio/runtime": "3.0.0-beta.27",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
